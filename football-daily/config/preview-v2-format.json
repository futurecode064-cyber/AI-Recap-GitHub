{
  "name": "Future Code Preview V2",
  "version": "2.1",
  "permanent": true,
  "timezone": "Asia/Yangon",
  "source": {
    "report": "data/today.json",
    "canonicalFixtureKey": "fixtureId",
    "fullOriginal": "dailyPreviewText",
    "editorial": "previewV2Summary",
    "selection": "previewV2Selection",
    "editorialDate": "previewV2EditorialDate",
    "sourceDate": "previewV2SourcePreviewDate",
    "status": "previewV2EditorialStatus",
    "image": "previewV2Media"
  },
  "content": {
    "summaryMinLength": 300,
    "summaryMaxLength": 760,
    "minSentences": 4,
    "editorialRequired": true,
    "allowMechanicalExcerpts": false,
    "requireNamedSelection": true,
    "keepOriginalUnchanged": true,
    "requireMyanmarNames": true,
    "requireBothCrests": true,
    "requireSourceDateMatch": true,
    "editorialStructure": [
      "home club's most important factor",
      "away club's most important factor",
      "decisive matchup-specific reasoning",
      "source-approved named selection"
    ]
  },
  "display": {
    "font": "FCMyanmar",
    "fontFallback": "Noto Sans Myanmar",
    "wordBreak": "Intl.Segmenter(my,word)",
    "cardWidthPx": 1200,
    "cardHeightPx": null,
    "gapPx": 4,
    "oddsStripOrder": [
      "home crest/name",
      "goal total odds",
      "12-hour Myanmar-local kickoff",
      "body/handicap odds",
      "away name/crest"
    ],
    "originalAndCurrentSeparate": true,
    "designStyle": "compact fixed-grid green/gold journal layout, with selected frame color, gold accents, photo left, editorial right, selection strip and one-row odds",
    "cardHeightPolicy": "measured per-fixture from full Burmese text; photo and analysis always equal-height",
    "photoPolicy": "Verified historical match or player photo (with credit and clearly dated historical context); never replace with logos or claim as current-day picture"
  },
  "export": {
    "groupSizes": [
      1,
      2,
      3
    ],
    "bannerPolicy": "single pair per final combined PNG",
    "pipeline": [
      "render unframed cards",
      "stack in fixture order",
      "wrap selected frame once",
      "encode PNG or ZIP"
    ],
    "forbidInnerBanners": true,
    "frameThemeFromEditor": true,
    "zipContainsPNG": true
  },
  "qa": {
    "validateDailyJSON": true,
    "comparePdfNames": true,
    "testDynamicFixtureCount": true,
    "testEditorialDate": true,
    "testFullPreview": true,
    "testSingleBannerViaHeightDelta": true,
    "checkImageAndLogoFidelity": true,
    "checkPNGAndZIP": true,
    "verifyCloudflareLive": true
  }
}
